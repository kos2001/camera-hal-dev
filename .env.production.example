# Copy to .env.production and replace every value before deployment.
CAMHAL_PUBLIC_URL=https://camhal.example.com
CAMHAL_OIDC_ISSUER=https://id.example.com/realms/camhal
CAMHAL_OIDC_AUDIENCE=camhal-api
CAMHAL_OIDC_JWKS_URL=https://id.example.com/realms/camhal/protocol/openid-connect/certs
CAMHAL_OIDC_CLIENT_ID=camhal-web
CAMHAL_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
CAMHAL_OIDC_SCOPE=openid email profile camhal-api
CAMHAL_ALLOWED_EMAIL_DOMAIN=example.com
CAMHAL_COOKIE_SECRET=replace-with-random-base64-32-byte-secret
# Use an unused Docker subnet. The proxy IP must belong to this subnet.
CAMHAL_AUTH_SUBNET=172.30.250.0/24
CAMHAL_PROXY_IP=172.30.250.10
